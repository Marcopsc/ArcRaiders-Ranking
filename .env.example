# Copie este arquivo para .env.local (uso local) e configure as mesmas
# variáveis nas configurações do projeto na Vercel (Settings → Environment
# Variables) para produção.

# String de conexão do banco Postgres (Neon, Supabase, Railway, etc).
# Deve incluir "?sslmode=require" quando o provedor exigir SSL (a maioria exige).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Senha inicial do administrador. Só é usada pelo script de setup (db/seed.js)
# na primeira vez que o banco é preparado — depois disso, troque a senha pelo
# próprio painel admin (/admin → "Trocar senha").
ADMIN_PASSWORD=ARCraiders2026!

# Segredo usado para assinar o cookie de sessão do admin. Gere um valor
# aleatório e longo (ex: openssl rand -base64 32) e NUNCA reaproveite o
# valor de exemplo abaixo em produção.
SESSION_SECRET=troque-este-valor-por-uma-string-aleatoria-longa
